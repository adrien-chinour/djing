# Installed by scripts/install-visuals-service.sh (placeholders substituted).
[Unit]
Description=djing visuals: sound analysis and TV pages (audio-server.js)
After=pipewire.service

[Service]
WorkingDirectory=@REPO@
ExecStart=@NODE@ @REPO@/visuals/audio-server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
