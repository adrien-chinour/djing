#!/usr/bin/env bash
# switch — activate a visual (written to active.html, served by the iframe of index.html)
# Usage: ./switch corridor | sunburst | <name>
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  echo "Usage: ./switch <visuel>"
  echo ""
  echo "Visuels disponibles :"
  for f in "$DIR"/*.html; do
    name="$(basename "$f" .html)"
    [[ "$name" == "index" || "$name" == "active" || "$name" == "debug" ]] && continue
    if diff -q "$f" "$DIR/active.html" > /dev/null 2>&1; then
      echo "  $name  ← actif"
    else
      echo "  $name"
    fi
  done
}

if [ $# -eq 0 ]; then usage; exit 0; fi

case "$1" in
  index|active|debug)
    echo "Erreur : '$1' n'est pas un visuel."
    exit 1 ;;
esac

TARGET="$DIR/$1.html"

if [ ! -f "$TARGET" ]; then
  echo "Erreur : visuel '$1' introuvable (fichier $TARGET absent)."
  echo ""
  usage
  exit 1
fi

cp "$TARGET" "$DIR/active.html"
echo "✓ active → $1"
