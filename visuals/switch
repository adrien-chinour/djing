#!/usr/bin/env bash
# switch — activate a visual (written to active.html, served by the iframe of index.html)
# Usage: ./switch corridor | sunburst | <name>
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
RESERVED='index|active|control|debug'   # never shown on the TV (same lists as audio-server.js)
TOOLS='webgl-check'                     # not visuals, but can be shown on the TV

usage() {
  echo "Usage: ./switch <visuel>"
  echo ""
  echo "Visuels disponibles :"
  for f in "$DIR"/*.html; do
    name="$(basename "$f" .html)"
    [[ "$name" =~ ^($RESERVED|$TOOLS)$ ]] && continue
    if diff -q "$f" "$DIR/active.html" > /dev/null 2>&1; then
      echo "  $name  ← actif"
    else
      echo "  $name"
    fi
  done
  echo ""
  echo "Outils : ${TOOLS//|/ }"
}

if [ $# -eq 0 ]; then usage; exit 0; fi

if [[ "$1" =~ ^($RESERVED)$ ]]; then
  echo "Erreur : '$1' ne peut pas être affiché sur la TV."
  exit 1
fi

TARGET="$DIR/$1.html"

if [ ! -f "$TARGET" ]; then
  echo "Erreur : visuel '$1' introuvable (fichier $TARGET absent)."
  echo ""
  usage
  exit 1
fi

cp "$TARGET" "$DIR/active.html"
echo "✓ active → $1"
