#!/usr/bin/env bash
# switch — activate a visual on the local session of a running audio-server.js (POST /active/<name>)
# Usage: ./switch corridor | sunburst | <name>      (PORT=8765 by default)
set -euo pipefail

BASE="http://localhost:${PORT:-8765}"

usage() {
  echo "Usage: ./switch <visuel>"
  echo ""
  if ! json="$(curl -fsS "$BASE/visuals" 2>/dev/null)"; then
    echo "Le serveur ne répond pas sur $BASE : lancer 'make visuals' d'abord."
    return
  fi
  echo "Visuels disponibles :"
  node -e '
    const d = JSON.parse(process.argv[1]);
    for (const v of d.visuals) console.log("  " + v + (v === d.active ? "  ← actif" : ""));
    console.log("\nOutils : " + d.tools.join(" "));
  ' "$json"
}

if [ $# -eq 0 ]; then usage; exit 0; fi

if out="$(curl -sS -w '\n%{http_code}' -X POST "$BASE/active/$1" 2>&1)"; then
  code="${out##*$'\n'}"
  body="${out%$'\n'*}"
  if [ "$code" = "200" ]; then
    echo "✓ active → $1"
  else
    echo "Erreur ($code) : $body"
    exit 1
  fi
else
  echo "Le serveur ne répond pas sur $BASE : lancer 'make visuals' d'abord."
  exit 1
fi
